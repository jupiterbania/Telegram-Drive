{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tg-drive-license-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg-drive-licenses",
      "database_id": "a3b1ffec-2e8c-498c-8545-adf69dcb1133",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "TG Drive: Unlimited Cloud",
    "STORE_URL": "https://rzp.io/rzp/eBLEV0w",
    "MAX_DEFAULT_DEVICES": "2"
  },
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  }
}

