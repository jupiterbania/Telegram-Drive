# Master admin secret for accessing /admin dashboard and /api/admin/* endpoints
ADMIN_SECRET="my-super-secret-admin-password"

# Lemon Squeezy webhook secret (for auto-generating licenses on purchase)
LEMON_SQUEEZY_WEBHOOK_SECRET="your-lemonsqueezy-webhook-secret"

# Optional: Custom Ed25519 JWK keys for JWT signing (falls back to HMAC with ADMIN_SECRET if omitted)
# SIGNING_PRIVATE_KEY='{"kty":"OKP","crv":"Ed25519","d":"...","x":"..."}'
# SIGNING_PUBLIC_KEY='{"kty":"OKP","crv":"Ed25519","x":"..."}'

